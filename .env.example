APP_NAME=Base-IMIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log

# -----------------------------------------------------------------------------
# PII encryption and controlled-access settings
# Use different encryption keys for local, staging, and production environments.
# Never store an actual PII key inside this file or anywhere in the repository.
# -----------------------------------------------------------------------------

# Selects the key provider implementation. "file" reads a Base64 key from an
# external file; it is the provider currently implemented by PiiServiceProvider.
PII_KEY_PROVIDER=file

# Identifies the key version used for all new encryption operations. Existing
# ciphertext retains its version so older configured keys can still decrypt it.
PII_ACTIVE_KEY_VERSION=v1

# Absolute path to the external v1 key file. Keep the file outside the project,
# readable only by the application operating-system account.
PII_KEY_V1_FILE=

# Optional v2 key-file path used when performing a future key rotation. Configure
# it before changing PII_ACTIVE_KEY_VERSION to v2.
PII_KEY_V2_FILE=

# Allows temporarily reading legacy plaintext during migration. Set this to false
# after every existing PII value has been encrypted and successfully verified.
PII_ALLOW_LEGACY_PLAINTEXT=true

# Records authorized and rejected PII access events without recording plaintext.
# Keep this enabled in staging and production.
PII_AUDIT_ENABLED=true

# Number of days allowed between administrator downloads of the active key backup.
PII_KEY_BACKUP_INTERVAL_DAYS=60

# Shows the key-backup warning this many days before the interval expires.
PII_KEY_BACKUP_WARNING_DAYS=5

# Maximum number of unique BIN values accepted by a Building owner-PII CSV export.
PII_EXPORT_MAX_BINS=5000

# Maximum number of Application IDs/BIN entries accepted by an Application PII export.
PII_EXPORT_MAX_APPLICATION_IDS=5000

# Maximum number of tax codes accepted by a Property Tax owner-PII CSV export.
PII_EXPORT_MAX_TAX_CODES=5000

# Maximum uploaded PII selection CSV size in kilobytes.
PII_EXPORT_MAX_FILE_KB=2048

# -----------------------------------------------------------------------------
# Public-ID URL binding
# No environment variable is required. Building and Containment public UUIDs are
# generated by the URL-binding migration and resolved through model route binding.
# -----------------------------------------------------------------------------

CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
REMEMBER_ME=4320

MEMCACHED_HOST=127.0.0.1

MAIL_DRIVER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

#GEOSERVER WORKSPACE
GEOSERVER_WORKSPACE=base_imis

#SERVER GEOSERVER
GEOSERVER = http://<server_ip>:8080/geoserver/
GEOSERVER_URL = http://<server_ip>:8080/geoserver/<workspace_name>/
AUTH_KEY = <auth_key>

# BASE MAP API KEYS
API_KEY_BING = ''
API_KEY_GOOGLE = ''

#PGSQL
PGSQL_BIN_PATH=/usr/lib/postgresql/14/bin/


#WKHTML LIVE SERVER
WKHTML_PDF_BINARY = /usr/bin/wkhtmltopdf
WKHTML_IMG_BINARY = /usr/bin/wkhtmltoimage

# CSV Import file path
FILE_SYSTEM_IMPORT_TAX=storage/taxpayment
FILE_SYSTEM_IMPORT_WATERSUPPLY=storage/watersupply
FILE_SYSTEM_IMPORT_SWM=storage/swmpayment
